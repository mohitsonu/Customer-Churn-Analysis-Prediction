   "source": [
    "import pandas as pd\n",
    "\n",
    "# Load dataset\n",
    "df = pd.read_csv(\"../data/telco_churn.csv\")\n",
    "\n",
    "# Drop customerID\n",
    "df.drop(\"customerID\", axis=1, inplace=True)\n",
    "\n",
    "# Map Churn to 0/1\n",
    "df[\"Churn\"] = df[\"Churn\"].map({\"Yes\": 1, \"No\": 0})\n",
    "\n",
    "# Check data types\n",
    "df.info()"
   ]
  }
